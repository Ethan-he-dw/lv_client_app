 static volatile sig_atomic_t g_run = 1;
 static void OnSig(int) { g_run = 0; }
 
+/** 单实例锁（PLAN-REGISTER-HOST-20261104 D5）：防双实例同时注册同名 FaceService——
+ *  那会让 SM 里的 advertise 停留在旧实例（127.0.0.1），表现为"日志说设了、omni-cli 还是回环"。
+ *  与 media_proc 的 AcquireSingleInstanceLock 同构（apps/media_proc/main.cpp:35）。
+ *  @note flock 随进程退出（含 kill -9）由内核释放，不留陈旧锁；pidof/pgrep 判重有并发竞态。
+ *  @note 只在 kRun（识别/注册长驻模式）抢锁——库管理工具必须能在服务运行时执行。 */
+static int AcquireSingleInstanceLock() {
+    const char* kLockPath = "/tmp/.face_proc.lock";
+    const int fd = open(kLockPath, O_RDWR | O_CREAT | O_CLOEXEC, 0644);
+    if (fd < 0) {
+        MIPC_LOG_ERROR("[face] open single-instance lock fail: %s", kLockPath);
+        return -1;
+    }
+    if (flock(fd, LOCK_EX | LOCK_NB) != 0) {
+        MIPC_LOG_ERROR("[face] another face_proc is running (lock held: %s)", kLockPath);
+        (void)close(fd);
+        return -1;
+    }
+    return 0; /* fd 故意不关：随进程退出由内核释放 */
+}
+
 int main(int argc, char **argv) {
     mediaipc::FaceCliOptions opt;
     if (mediaipc::ParseFaceCli(argc, argv, &opt) != 0) return 2;
@@ -38,6 +61,9 @@ int main(int argc, char **argv) {
     signal(SIGINT, OnSig);
     signal(SIGTERM, OnSig);
 
+    /* 分发之后、初始化之前抢锁：库工具（--gallery-*）已在上面 return，不受影响 */
+    if (AcquireSingleInstanceLock() != 0) return 4;   /* 4 = 重复实例（0/1/2/3 各有语义，见文档） */
+
     /* opt 必须活到 app 结束（Config 的 const char* 指向其内部字符串） */
     const mediaipc::FaceProcApp::Config cfg = mediaipc::BuildFaceConfig(opt);
     mediaipc::FaceProcApp app(cfg);

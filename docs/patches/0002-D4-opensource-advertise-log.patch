diff --git a/src/core/runtime_service.cpp b/src/core/runtime_service.cpp
index 6dfcbf0..8948b04 100644
--- a/src/core/runtime_service.cpp
+++ b/src/core/runtime_service.cpp
@@ -77,6 +77,10 @@ int OmniRuntime::Impl::initializeServiceListener(LocalServiceEntry* entry, Servi
     service->setPort(entry->port);
     service->runtime_ = owner_;
     advertise_host = resolveRegisterHost(service, listenerAdvertiseHost());
+    /* 【2026-11-04】跨机排查唯一直接证据：注册时实际广告的地址与端口。
+     * 在此之前 advertise 无任何日志，跨机连不上时无法区分"没设/设错/设了没生效"。 */
+    OMNI_LOG_INFO(LOG_TAG, "service %s advertise %s:%u", service->name().c_str(),
+                  advertise_host.c_str(), (unsigned)entry->port);
     wireServiceEndpoint(service->name(), entry, tcp);
     return 0;
 }
